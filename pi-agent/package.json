{
  "name": "@nothumanwork/pi-agent",
  "version": "0.3.0",
  "type": "module",
  "description": "Home-rooted specialist agents with native Pi sessions, approved definitions and scheduled loops",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thehumanworks/pi-extensions.git",
    "directory": "pi-agent"
  },
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "croner": "^9.1.0",
    "ignore": "^7.0.14",
    "proper-lockfile": "^4.1.2",
    "typebox": "^1.4.3",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "@types/bun": "latest"
  }
}
