{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@nothumanwork/pi-orchestration": ["./src/index.ts"],
      "@nothumanwork/pi-orchestration/recipes": ["./src/recipes.ts"]
    }
  },
  "include": ["index.ts", "src/**/*.ts", "test/**/*.ts", "examples/workflows/**/*.ts"]
}
