{
  "name": "@nothumanwork/pi-bot",
  "version": "0.3.0",
  "type": "module",
  "description": "Pi commands, tools and conversation UI for the @nothumanwork/bot SDK",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thehumanworks/pi-extensions.git",
    "directory": "pi-bot"
  },
  "files": [
    "index.ts",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "npm run build --workspace @nothumanwork/bot && tsc --noEmit",
    "test": "npm run build --workspace @nothumanwork/bot && tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@nothumanwork/bot": "^0.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
