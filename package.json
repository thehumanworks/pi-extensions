{
  "name": "pi-extensions",
  "private": true,
  "type": "module",
  "workspaces": [
    "bot",
    "bot/packages/runtime",
    "bot/packages/ai-sdk",
    "bot/apps/web",
    "pi-advisor",
    "pi-atlassian",
    "pi-bot",
    "pi-background-compaction",
    "pi-canary",
    "pi-fast",
    "pi-loop",
    "pi-memory",
    "pi-orchestration",
    "pi-remote",
    "pi-tps",
    "pi-usage",
    "pi-voice",
    "pi-xai"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test:packages": "node --test scripts/packages.test.mjs",
    "test": "npm run test:scripts && npm run test --workspaces --if-present",
    "test:scripts": "node --test scripts/publish.test.mjs scripts/publish-updated.test.mjs",
    "publish:package": "node scripts/publish.mjs",
    "publish:updated": "node scripts/publish-updated.mjs",
    "check": "npm run check --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "pack:check": "npm run build && npm run test:packages"
  },
  "devDependencies": {
    "semver": "^7.8.5"
  }
}
