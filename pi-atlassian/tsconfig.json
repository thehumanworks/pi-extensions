{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node"],
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true,
    "verbatimModuleSyntax": true, "allowImportingTsExtensions": true, "noEmit": true
  },
  "include": ["index.ts", "src/**/*.ts"], "exclude": ["tests", "node_modules"]
}
