{
  "name": "@nothumanwork/bot-ai-sdk",
  "version": "0.1.0",
  "description": "Framework-independent AI SDK UI message transport for a durable bot backend",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thehumanworks/pi-extensions.git",
    "directory": "bot/packages/ai-sdk"
  },
  "keywords": ["ai-sdk", "useChat", "bot", "durable"],
  "files": ["dist", "README.md", "API.md"],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./server": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": { "ai": "^7.0.155" },
  "devDependencies": { "ai": "7.0.155", "@types/node": "^22.19.0", "tsx": "^4.20.0", "typescript": "^5.9.3" }
}
