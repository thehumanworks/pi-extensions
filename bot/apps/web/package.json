{
  "name": "@nothumanwork/bot-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A maintained web client for a separately supervised bot daemon",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "dev": "next dev --hostname ::1 --port 3001",
    "build": "next build",
    "build:native": "bun run scripts/build-native.ts",
    "start": "next start --hostname ::1 --port 3001",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.native.json",
    "test:native": "bun test native/test",
    "test": "tsx --test test/*.test.ts test/*.test.tsx"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.159",
    "@nothumanwork/bot-ai-sdk": "0.1.0",
    "ai": "7.0.155",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
